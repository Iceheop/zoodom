---
import Section from "../layouts/Section.astro";
import familiaZoodomImg from "../assets/images/gallery-familia-zoodom.webp";
import visitasGuiadasImg from "../assets/images/gallery-camino-safari.webp";
import sesionesFotoImg from "../assets/images/gallery-flamencos.webp";
import Vector from "../assets/ui/vector.webp";

const events = [
    {
        title: "Labor Social",
        description:
            "El Zoologico Nacional, en cumplimiento de la ley Num. 179-03 del Ministerio de Educacion, realiza labores educativas para estudiantes de nivel medio y actividades comunitarias en Zooodom.",
        image: familiaZoodomImg.src,
        imageAlt: "Actividad social en el zoologico",
        reverse: false
    },
    {
        title: "Visitas Guiadas",
        description:
            "Las visitas guiadas son recorridos educativos por el zoologico nacional. Estan a cargo de guias capacitados que acompanan al visitante y comparten informacion sobre cada especie.",
        image: visitasGuiadasImg.src,
        imageAlt: "Recorrido guiado en el zoologico",
        reverse: true
    },
    {
        title: "Sesiones Fotograficas",
        description:
            "El parque tiene habilitado el servicio de sesiones fotograficas para familias, centros educativos y amantes de la naturaleza, con escenas unicas dentro del parque.",
        image: sesionesFotoImg.src,
        imageAlt: "Sesion fotografica en el zoologico",
        reverse: false
    }
];
---

<!-- Section Events -->
<Section id="events">
    <header class="d-flex justify-content-between align-items-start mb-5 pb-5">
        <div>
            <h2 class="display-4 fw-bold text-primary m-0">Eventos</h2>
            <p class="text-primary m-0">Descubre nuestros eventos locales</p>
        </div>
        <div>
            <a href="/blog" aria-label="Ver novedades de eventos en el blog">
                <i class="text-primary bi bi-arrow-right-short display-4"></i>
            </a>
        </div>
    </header>

    <div class="d-flex flex-column events-stack">
        {events.map((event) => (
            <article class="row justify-content-between gy-4 gy-lg-5 event-item">
                <div class={`col-12 col-lg-4 ${event.reverse ? "order-lg-2" : "order-lg-1"}`}>
                    <h3 class="display-6 fw-bold text-primary mb-3">{event.title}</h3>
                    <p class="text-primary mb-4 event-copy">{event.description}</p>
                    <a href="/blog" class="btn btn-brand rounded-pill px-5 fw-semibold">Leer mas</a>
                </div>
                <div class={`col-12 col-lg-8 position-relative event-visual ${event.reverse ? "order-lg-1" : "order-lg-2"}`}>
                    <figure class={`event-media  m-0 ${event.reverse ? "event-media--left" : "event-media--right"}`}>
                        <img src={event.image} alt={event.imageAlt} class="img-fluid w-100 event-image position-relative z-2" loading="lazy" />
                    </figure>
                    <img
                        src={Vector.src}
                        alt="Vector decorativo"
                        class="img-fluid position-absolute z-1 vector"
                        loading="lazy"
                    />
                </div>
            </article>
        ))}
    </div>
</Section>

<style>
    .event-visual {
        overflow: visible;
    }

    .events-stack {
        gap: 6rem;
    }

    .event-item:hover .event-image {
        transform: scale(1.05);
        transition: transform 0.3s ease;
    }

    .vector {
        width: 78%;
        max-width: 500px;
        opacity: 0.95;
        pointer-events: none;
        left: 50%;
        bottom: -16%;
        transform: translateX(-50%);
    }
    .event-media {
        position: relative;
        border-radius: 3rem 0 3rem 0;
        overflow: hidden;
    }
    .event-image {
        aspect-ratio: 16 / 8;
        object-fit: cover;
        border-radius: 3rem 0 3rem 0;
        display: block;
    }

    @media (max-width: 991.98px) {
        .events-stack {
            gap: 3.5rem;
        }

        .event-image {
            aspect-ratio: 16 / 10;
        }
        .vector {
            width: 75%;
            max-width: 210px;
            bottom: -8%;
            left: 50%;
            transform: translateX(-50%);
        }
    }
</style>