---
import Layout from '../layouts/Layout.astro';
import logo from'../assets/logo.svg';
import HeroImg from '../assets/hero.png';
import TextureImg from '../assets/texture-img.png';
---

<Layout>
	<main>
		<nav class="navbar navbar-expand-lg">
			<section class="container px-5 py-4">
				<a class="navbar-brand" href="#">
					<img src={logo.src} class="logo" alt="">
				</a>
				<ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-4">
					<li class="nav-item">
						<a class="nav-link active" aria-current="page" href="#">Inicio</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" href="#">Especies</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" href="#">Galeria</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" href="#">Blog</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" href="#">Contacto</a>
					</li>
				</ul>
			</section>
		</nav>
		<header class="position-relative py-5">
			<section class="container px-4 px-lg-5 py-5 my-5">
				<section class="row d-flex justify-content-between align-items-center">
					<section class="col-lg-6 col-md-6 col-12">
						<h1 class="display-1 fw-bold">Bienvenido a nuestro zoológico</h1>
						<p>Planea una salida en familia a nuestro parque zoológico nacional para que te diviertas en una esperiencia innovidable.</p>
						<button class="btn btn-brand px-5 py-2 rounded-pill">Reservar ahora</button>
					</section>
					<section class="col-lg-6 col-md-6 col-12 d-none d-md-block">
						<img src={HeroImg.src} class="img-fluid hero-img position-absolute bottom-0 end-0 pe-5" alt="Hero Image">
					</section>
				</section>
			</section>
		</header>
		<section id="animals" class="py-5">
			<section class="container">
				<br><br><br><br><br><br>
				<br><br><br><br><br><br>
				<br><br><br><br><br><br>
				<br><br><br><br><br><br>
			</section>
		</section>
			<br><br><br><br><br><br>
				<br><br><br><br><br><br>
				<br><br><br><br><br><br>
				<br><br><br><br><br><br>
				<br><br><br><br><br><br>
					<br><br><br><br><br><br>
				<br><br><br><br><br><br>
				<br><br><br><br><br><br>
				<br><br><br><br><br><br>
				<br><br><br><br><br><br>
					<br><br><br><br><br><br>
				<br><br><br><br><br><br>
				<br><br><br><br><br><br>
				<br><br><br><br><br><br>
				<br><br><br><br><br><br>
					<br><br><br><br><br><br>
				<br><br><br><br><br><br>
				<br><br><br><br><br><br>
				<br><br><br><br><br><br>
				<br><br><br><br><br><br>
	</main>
</Layout>

