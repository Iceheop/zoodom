---
import Layout from '../layouts/Layout.astro';
import logo from'../assets/logo.svg';
import HeroImg from '../assets/hero.webp';
import Shape from '../assets/shape.svg';
import Bufalo from '../assets/bufalo.webp';
---

<Layout>
	<main>
		<!-- Navigation -->
		<nav class="navbar navbar-expand-lg navbar-light">
			<section class="container px-3 px-lg-5 py-3">
				<a class="navbar-brand me-0" href="#">
					<!-- Móvil -->
					<img
						src={logo.src}
						class="img-fluid d-inline d-sm-none"
						width="80"
						alt="Logo"
					/>
					<!-- Tablet/Desktop -->
					<img
						src={logo.src}
						class="img-fluid d-none d-sm-inline"
						width="110"
						alt="Logo"
					/>
				</a>

				<button
					class="navbar-toggler border-0"
					type="button"
					data-bs-toggle="collapse"
					data-bs-target="#mainNavbar"
					aria-controls="mainNavbar"
					aria-expanded="false"
					aria-label="Toggle navigation"
				>
					<span class="navbar-toggler-icon"></span>
				</button>

				<section class="collapse navbar-collapse" id="mainNavbar">
					<ul class="navbar-nav ms-lg-auto mb-2 mb-lg-0 gap-lg-4 pt-3 pt-lg-0">
						<li class="nav-item"><a class="nav-link active" aria-current="page" href="#">Inicio</a></li>
						<li class="nav-item"><a class="nav-link" href="#">Especies</a></li>
						<li class="nav-item"><a class="nav-link" href="#">Galeria</a></li>
						<li class="nav-item"><a class="nav-link" href="#">Blog</a></li>
						<li class="nav-item"><a class="nav-link" href="#">Contacto</a></li>
					</ul>
				</section>
			</section>
		</nav>
		<!-- Header -->
		<header class="position-relative py-md-5 py-lg-5" style="min-height: 600px;">
			<section class="container px-3 px-lg-5 pb-lg-5 py-lg-3 my-5">
				<section class="row d-flex justify-content-between align-items-center position-relative h-100">
					<section class="col-lg-6 col-md-6 col-12">
						<h1 class="display-1 fw-bold">Bienvenido a nuestro zoológico</h1>
						<p>Planea una salida en familia a nuestro parque zoológico nacional para que te sientas en una experiencia inolvidable.</p>
						<button class="btn btn-brand px-5 py-2 rounded-pill">Reservar ahora</button>
					</section>
					<section class="col-lg-6 col-md-6 col-12 d-none d-md-block">
						<img src={HeroImg.src} class="img-fluid hero-img w-100 position-absolute bottom-0 end-0" alt="Hero Image" loading="eager">
					</section>
				</section>
			</section>
		</header>
		<!-- Animals -->
		<section id="animals" class="py-5">
			<section class="container px-3 px-lg-5 py-lg-5">
				<!-- Header -->
				<header class="d-flex justify-content-between">
					<section>
						<h2 class="display-4 fw-bold text-white m-0">Animales</h2>
						<p class="text-white m-0">Descubre nuestra increíble variedad de animales en su hábitat natural.</p>
					</section>
					<section>
						<a href="#">
							<i class="text-white bi bi-arrow-right-short display-4"></i>
						</a>
					</section>
				</header>
				<!-- Content -->
				<section class="row py-5 my-5 m-auto gap-5">
					<article class="card col-md-6 col-lg-4 bg-overlay p-5 rounded-3 text-white position-relative overflow-hidden">
						<h2 class="fw-bold">Bisonte Americano</h2>
						<h3 class="fw-light">Bison bison</h3>
						<p class="text-white ">Los Bisontes tienen un pelaje de color marrón oscuro durante el invierno, y uno más liviano de color marrón claro durante el verano.</p>
						<section class="mb-card d-flex gap-4">
							<a href="#">
								<i class="text-white bi bi-info-circle-fill display-6"></i>
							</a>
							<a href="#">
								<i class="text-white bi bi-plus-circle-fill display-6"></i>
							</a>
						</section>
						<img src={Shape.src} alt="Shape" class="position-absolute top-100 start-100 translate-middle shape">
						<img src={Bufalo.src} alt="Bufalo" class="img-fluid position-absolute bottom-0 end-0" height="300px">
					</article>
					<article class="card col-md-6 col-lg-4 bg-overlay p-5 rounded-3 text-white position-relative overflow-hidden">
						<h2 class="fw-bold">Bisonte Americano</h2>
						<h3 class="fw-light">Bison bison</h3>
						<p class="text-white ">Los Bisontes tienen un pelaje de color marrón oscuro durante el invierno, y uno más liviano de color marrón claro durante el verano.</p>
						<section class="mb-card d-flex gap-4">
							<a href="#">
								<i class="text-white bi bi-info-circle-fill display-6"></i>
							</a>
							<a href="#">
								<i class="text-white bi bi-plus-circle-fill display-6"></i>
							</a>
						</section>
						<img src={Shape.src} alt="Shape" class="position-absolute top-100 start-100 translate-middle shape">
						<img src={Bufalo.src} alt="Bufalo" class="img-fluid position-absolute bottom-0 end-0" height="300px">
					</article>
					<article class="card col-md-6 col-lg-4 bg-overlay p-5 rounded-3 text-white position-relative overflow-hidden">
						<h2 class="fw-bold">Bisonte Americano</h2>
						<h3 class="fw-light">Bison bison</h3>
						<p class="text-white ">Los Bisontes tienen un pelaje de color marrón oscuro durante el invierno, y uno más liviano de color marrón claro durante el verano.</p>
						<section class="mb-card d-flex gap-4">
							<a href="#">
								<i class="text-white bi bi-info-circle-fill display-6"></i>
							</a>
							<a href="#">
								<i class="text-white bi bi-plus-circle-fill display-6"></i>
							</a>
						</section>
						<img src={Shape.src} alt="Shape" class="position-absolute top-100 start-100 translate-middle shape">
						<img src={Bufalo.src} alt="Bufalo" class="img-fluid position-absolute bottom-0 end-0" height="300px">
					</article>
				</section>
			</section>
		</section>ç
	</main>
</Layout>

