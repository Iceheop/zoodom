---
import { Image } from "astro:assets";
import Shape from "../assets/ui/shape.svg";
import type { ImageMetadata } from "astro";

type CardAnimalProps = {
    name: string;
    scientificName: string;
    description: string;
    image: ImageMetadata;
    imageAlt: string;
    shapeColor?: string;
    variant?: "default" | "light-surface";
};

const {
    name,
    scientificName,
    description,
    image,
    imageAlt,
    shapeColor = "var(--color-extended-orange-100)",
    variant = "default"
} = Astro.props as CardAnimalProps;

const getLightBackgroundFromShape = (color: string): string => {
    if (color.includes("neutral-white")) return "var(--color-neutral-gray-800)";

    const tokenMatch = color.match(/^var\(--([^)]+)\)$/);
    if (!tokenMatch) return "var(--color-neutral-gray-100)";

    const baseToken = tokenMatch[1];
    const mediumToken = baseToken.startsWith("color-extended-")
        ? baseToken.replace(/-\d+$/, "-500")
        : baseToken.replace(/-\d+$/, "-800");

    return `var(--${mediumToken})`;
};

const isLightSurface = variant === "light-surface";
const cardBackground = isLightSurface ? getLightBackgroundFromShape(shapeColor) : "var(--color-neutral-overlay-900)";
const modalBackground = isLightSurface ? cardBackground : "rgba(0, 0, 0, 0.92)";
const shapeFillColor = "var(--color-neutral-white-900)";
const shapeOpacity = isLightSurface ? "0.22" : "0.9";
const cardTextColor = "var(--color-neutral-white-900)";
const cardSubtitleColor = "var(--color-neutral-white-900)";
const modalId = `animal-modal-${name
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "")}`;
const modalTitleId = `${modalId}-title`;

const shapeStyle = `--animal-shape-color: ${shapeFillColor}; --animal-shape-mask: url('${Shape.src}'); --animal-card-bg: ${cardBackground}; --animal-modal-bg: ${modalBackground}; --animal-shape-opacity: ${shapeOpacity}; --animal-card-text: ${cardTextColor}; --animal-card-subtitle: ${cardSubtitleColor};`;
---
<!-- Animal Card -->
<article class="card animal-card p-5 position-relative overflow-hidden" style={shapeStyle}>
    <header class="mb-2">
        <h2 class="fw-bold fs-3 mb-1">{name}</h2>
        <p class="fw-light fs-4 mb-0">{scientificName}</p>
    </header>
    <p>{description}</p>
    <div class="mb-card d-flex gap-4">
        <button
            type="button"
            class="animal-info-btn"
            data-bs-toggle="modal"
            data-bs-target={`#${modalId}`}
            aria-label={`Mas informacion sobre ${name}`}
        >
            <i class="bi bi-info-circle-fill display-6"></i>
        </button>
    </div>
    <span class="shape shape-mask position-absolute top-100 start-100 translate-middle" aria-hidden="true"></span>
    <Image
        src={image}
        alt={imageAlt}
        class="animal-image img-fluid position-absolute bottom-0 end-0"
        widths={[152, 201, 246, 300, 496]}
        sizes="(min-width: 992px) 246px, (max-width: 768px) 35vw, 200px"
        quality={60}
    />
</article>
<!-- End Animal Card -->

<!-- Animal Modal -->
<div class="modal fade" id={modalId} tabindex="-1" role="dialog" aria-modal="true" aria-labelledby={modalTitleId} aria-hidden="true" data-animal-modal="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content animal-modal-content text-white overflow-hidden" style={shapeStyle}>
            <button
                type="button"
                class="btn-close btn-close-white animal-modal-close"
                data-bs-dismiss="modal"
                aria-label="Cerrar"
            ></button>
            <div class="modal-body p-0">
                <section class="row g-0 align-items-stretch">
                    <section class="col-12 col-md-5 animal-modal-visual position-relative">
                        <span class="shape shape-mask animal-modal-shape position-absolute top-100 start-100 translate-middle" aria-hidden="true"></span>
                        <Image
                            src={image}
                            alt={imageAlt}
                            class="animal-modal-image img-fluid position-absolute bottom-0 end-0"
                            widths={[188, 220, 300, 496]}
                            sizes="(min-width: 992px) 300px, (min-width: 768px) 220px, 188px"
                            quality={60}
                        />
                    </section>
                    <section class="col-12 col-md-7 p-4 p-md-5">
                        <h3 class="fw-bold mb-1 text-white" id={modalTitleId}>{name}</h3>
                        <p class="fst-italic mb-4 text-white-50">{scientificName}</p>
                        <p class="mb-3 text-white">{description}</p>
                        <p class="mb-3 text-white">
                            En ZOODOM trabajamos en conservacion, educacion y bienestar animal. Durante tu visita,
                            puedes encontrar mas datos de esta especie en nuestras estaciones informativas.
                        </p>
                        <p class="mb-3 text-white">
                            Esta especie cumple un rol importante dentro de su ecosistema, ayudando al equilibrio
                            natural y a la biodiversidad de su habitat.
                        </p>
                        <ul class="animal-modal-list mb-0 text-white">
                            <li><strong>Habitat:</strong> Zonas adaptadas para su bienestar y comportamiento natural.</li>
                            <li><strong>Alimentacion:</strong> Dieta controlada por especialistas en nutricion animal.</li>
                            <li><strong>Conservacion:</strong> Programas de educacion y proteccion de especies.</li>
                            <li><strong>Dato curioso:</strong> Cada animal tiene rutinas de enriquecimiento ambiental diario.</li>
                        </ul>
                    </section>
                </section>
            </div>
        </div>
    </div>
</div>

<script>
    if (!(window as any).__animalModalsBound) {
        (window as any).__animalModalsBound = true;

        const moveModalsToBody = () => {
            document.querySelectorAll('[data-animal-modal="true"]').forEach((modal) => {
                if (modal.parentElement !== document.body) {
                    document.body.appendChild(modal);
                }
            });
        };

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", moveModalsToBody);
        } else {
            moveModalsToBody();
        }
    }
</script>

<style>
    .animal-card {
        border-radius: 75px 0 75px 0 !important;
        height: 590px;
        background: linear-gradient(rgba(0, 0, 0, 0.12), rgba(0, 0, 0, 0.12)), var(--animal-card-bg) !important;
        color: var(--animal-card-text);
    }

    .animal-card h2,
    .animal-card header p {
        margin: 0;
        color: var(--animal-card-text);
    }

    .animal-card header p {
        color: var(--animal-card-subtitle);
    }

    .animal-card p,
    .animal-card i {
        color: var(--animal-card-text) !important;
    }

    .animal-image {
        width: auto;
        height: clamp(160px, 18vw, 260px);
        object-fit: contain;
        pointer-events: none;
        bottom: -15px;
    }

    .shape-mask {
        background-color: var(--animal-shape-color);
        mask-image: var(--animal-shape-mask);
        -webkit-mask-image: var(--animal-shape-mask);
        mask-repeat: no-repeat;
        -webkit-mask-repeat: no-repeat;
        mask-position: center;
        -webkit-mask-position: center;
        mask-size: contain;
        -webkit-mask-size: contain;
        width: 785px;
        aspect-ratio: 1068 / 1051;
        opacity: var(--animal-shape-opacity);
        pointer-events: none;
    }

    .animal-info-btn {
        background: transparent;
        border: 0;
        padding: 0;
        line-height: 1;
    }

    .animal-info-btn:focus-visible {
        outline: 2px solid var(--color-neutral-white-900);
        outline-offset: 4px;
        border-radius: 999px;
    }

    .animal-modal-content {
        border-radius: 75px 0 75px 0;
        background: linear-gradient(rgba(0, 0, 0, 0.12), rgba(0, 0, 0, 0.12)), var(--animal-modal-bg) !important;
    }

    .animal-modal-content h3,
    .animal-modal-content p,
    .animal-modal-content li {
        color: var(--color-neutral-white-900) !important;
    }

    .animal-modal-list {
        padding-left: 1.1rem;
    }

    .animal-modal-list li {
        margin-bottom: 0.5rem;
    }

    .animal-modal-close {
        position: absolute;
        top: 1rem;
        right: 1rem;
        z-index: 5;
    }

    .animal-modal-visual {
        min-height: 280px;
        background: rgba(255, 255, 255, 0.06);
        border-right: 1px solid rgba(255, 255, 255, 0.15);
        overflow: hidden;
    }

    .animal-modal-shape {
        width: 785px;
        aspect-ratio: 1068 / 1051;
        z-index: 0;
    }

    .animal-modal-image {
        width: auto;
        height: clamp(160px, 18vw, 280px);
        z-index: 1;
        pointer-events: none;
        bottom: -15px;
    }

    @media (min-width: 992px) {
        .animal-modal-visual {
            min-height: 340px;
        }

        .animal-modal-shape {
            width: 880px;
        }

        .animal-modal-image {
            height: clamp(210px, 22vw, 360px);
        }
    }

    @media (max-width: 768px) {
        .animal-card {
            height: 500px;
        }

        .animal-image {
            height: clamp(188px, 35vw, 248px);
        }
        .shape-mask {
            height: clamp(550px, 100vw, 500px);
        }

        .animal-modal-image {
            height: clamp(188px, 35vw, 248px);
        }

        .animal-modal-visual {
            min-height: 220px;
            border-right: 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.15);
        }
    }
</style>