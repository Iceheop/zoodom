---
import type { BlogPost } from "../data/blogPosts";

type BlogCardProps = Omit<BlogPost, "id">;

const { title, date, category, excerpt, image, imageAlt, readTime, href } = Astro.props as BlogCardProps;
---

<article class="blog-card card h-100 border-0 shadow-sm overflow-hidden">
    <img src={image} alt={imageAlt} class="blog-card-image" loading="lazy" />
    <div class="card-body p-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <span class="badge text-bg-light text-primary">{category}</span>
            <span class="small text-secondary">{readTime}</span>
        </div>
        <h3 class="h4 fw-bold mb-2 text-primary">
            <a class="blog-card-link" href={href}>{title}</a>
        </h3>
        <p class="small text-secondary mb-3">{date}</p>
        <p class="mb-0 blog-card-excerpt">{excerpt}</p>
        <a class="blog-card-readmore" href={href}>Leer mas</a>
    </div>
</article>

<style>
    .blog-card {
        border-radius: 60px 0 60px 0;
        background-color: var(--color-neutral-white-900);
    }

    .blog-card-image {
        width: 100%;
        height: 220px;
        object-fit: cover;
    }

    .blog-card-excerpt {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-bottom: 1rem;
    }

    .blog-card-link {
        color: inherit;
        text-decoration: none;
    }

    .blog-card-link:hover {
        text-decoration: underline;
    }

    .blog-card-readmore {
        font-weight: 600;
        color: var(--color-brand-green-800);
        text-decoration: none;
    }

    .blog-card-readmore:hover {
        text-decoration: underline;
    }
</style>
