---
import logo from "../assets/ui/logo.svg";
import textureBg from "../assets/backgrounds/texture.webp";

const footerColumns = [
    {
        title: "Visitanos",
        items: ["Lunes a domingo: 9:00 AM - 5:00 PM", "Santo Domingo, Republica Dominicana", "Venta de entradas en linea y en taquilla", "Parqueo disponible para visitantes"]
    },
    {
        title: "Experiencias",
        items: ["Visitas guiadas para centros educativos", "Eventos y jornadas familiares", "Sesiones fotograficas en el parque", "Rutas tematicas por especies"]
    },
    {
        title: "Conservacion",
        items: ["Programas de bienestar animal", "Educacion ambiental comunitaria", "Apoyo a rescate y rehabilitacion", "Voluntariado y alianzas locales"]
    }
];
---

<footer class="zoodom-footer mt-5" style={`--footer-bg: url('${textureBg.src}')`}>
    <section class="container px-3 px-lg-5 py-5 py-lg-6">
        <section class="row gy-5 gx-lg-5 gx-xl-6">
            {footerColumns.map((column) => (
                <article class="col-12 col-md-6 col-lg-2">
                    <p class="footer-frame mb-1">ZOODOM</p>
                    <h3 class="footer-title mb-3">{column.title}</h3>
                    <ul class="footer-list list-unstyled m-0">
                        {column.items.map((item) => (
                            <li>{item}</li>
                        ))}
                    </ul>
                </article>
            ))}

            <article class="col-12 col-lg-4">
                <p class="footer-frame mb-1">Nuestra mision</p>
                <h3 class="footer-title mb-3">Cuidado y educacion</h3>
                <p class="footer-copy mb-0">
                    En ZOODOM protegemos la biodiversidad a traves del cuidado responsable de especies,
                    experiencias educativas y actividades que conectan a las familias con la naturaleza.
                </p>
            </article>
        </section>

        <section class="footer-bottom d-flex flex-column flex-lg-row align-items-center justify-content-between gap-3 mt-5 mt-lg-6 pt-4">
            <img src={logo.src} alt="Logo ZOODOM" class="footer-logo" />
            <p class="footer-copyright m-0">Copyright © Disenado y desarrollado por Ronald Santana 2025</p>
            <span class="footer-spacer d-none d-lg-inline"></span>
        </section>
    </section>
</footer>

<style>
    .zoodom-footer {
        position: relative;
        background-image:
            linear-gradient(180deg, rgba(16, 81, 30, 0.72) 0%, rgba(20, 74, 31, 0.82) 100%),
            var(--footer-bg);
        background-size: cover, cover;
        background-position: center;
        color: #ffffff;
    }

    .py-lg-6 {
        padding-top: 5rem !important;
        padding-bottom: 5rem !important;
    }

    .gx-xl-6 {
        --bs-gutter-x: 4rem;
    }

    .mt-lg-6 {
        margin-top: 4rem !important;
    }

    .footer-frame {
        color: rgba(255, 255, 255, 0.72);
        font-size: 0.9rem;
        margin-top: 0;
        margin-bottom: 0;
    }

    .footer-title {
        font-size: 1.9rem;
        font-weight: 700;
        line-height: 1.1;
        margin: 0;
        color: #ffffff;
    }

    .footer-list li {
        color: rgba(255, 255, 255, 0.9);
        margin-bottom: 0.7rem;
        line-height: 1.45;
        font-size: 1rem;
    }

    .footer-copy {
        color: rgba(255, 255, 255, 0.92);
        font-size: 1.25rem;
        line-height: 1.35;
    }

    .footer-bottom {
        border-top: 1px solid rgba(255, 255, 255, 0.2);
    }

    .footer-logo {
        width: 130px;
        height: auto;
        filter: brightness(0) invert(1);
    }

    .footer-copyright {
        color: rgba(255, 255, 255, 0.88);
        text-align: center;
    }

    .footer-spacer {
        width: 130px;
    }
</style>
