---
import logo from "../assets/ui/logo.svg";
import textureBg from "../assets/backgrounds/texture.webp";

const footerColumns = [
    {
        title: "Visitanos",
        items: ["Lunes a domingo: 9:00 AM - 5:00 PM", "Santo Domingo, Republica Dominicana", "Venta de entradas en linea y en taquilla", "Parqueo disponible para visitantes"]
    },
    {
        title: "Experiencias",
        items: ["Visitas guiadas para centros educativos", "Eventos y jornadas familiares", "Sesiones fotograficas en el parque", "Rutas tematicas por especies"]
    },
    {
        title: "Conservacion",
        items: ["Programas de bienestar animal", "Educacion ambiental comunitaria", "Apoyo a rescate y rehabilitacion", "Voluntariado y alianzas locales"]
    }
];
---
<!-- Footer -->
<footer id="footer" class="py-4 text-white">
    <section class="container px-3 px-lg-5 py-5 py-lg-6">
        <section class="row gy-5 gx-lg-5 gx-xl-6 justify-content-between">
            {footerColumns.map((column) => (
                <article class="col-12 col-md-6 col-lg-2">
                    <h4 class="footer-title mb-3">{column.title}</h4>
                    <ul class="footer-list list-unstyled m-0">
                        {column.items.map((item) => (
                            <li>{item}</li>
                        ))}
                    </ul>
                </article>
            ))}
            <article class="col-12 col-lg-4">
                <h4 class="m-0 mb-1">Nuestra mision</h4>
                <p class="mb-0 text-white">
                    En ZOODOM protegemos la biodiversidad a traves del cuidado responsable de especies,
                    experiencias educativas y actividades que conectan a las familias con la naturaleza.
                </p>
            </article>
        </section>
        <section class="d-flex flex-column flex-lg-row align-items-start align-items-lg-end justify-content-between gap-3 mt-5 mt-lg-6 pt-5">
            <img src={logo.src} alt="Logo ZOODOM" class="footer-logo" />
            <p class="text-white m-0">Copyright © Disenado y desarrollado por Ronald Santana 2025</p>
        </section>
    </section>
</footer>
<!-- End Footer -->