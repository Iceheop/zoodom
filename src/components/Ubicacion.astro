---
import Section from "../layouts/Section.astro";
---

<Section id="ubicacion">
    <div class="mb-5 pb-1 text-center">
        <h2 class="display-4 fw-bold text-primary mb-4">Ubicación</h2>
        <p class="fs-5 text-muted mb-5">
            Visítanos en nuestras instalaciones ubicadas en el corazón de la capital. 
            Estamos convenientemente ubicados para que disfrutes de una experiencia inolvidable 
            con tu familia y amigos.
        </p>
    </div>

    <!-- Información en una fila -->
    <div class="row mb-5">
        <div class="col-md-4 mb-3 mb-md-0">
            <div class="d-flex flex-column justify-content-center align-items-center text-center">
                <i class="bi bi-currency-dollar text-primary fs-1"></i>
                <h2 class="fw-bold fs-4 m-0 mb-3">Costo</h2>
                <p class="text-muted m-0">200 adultos / 150 niños. (No incluye tren) Precio de tour en Tren RD$50</p>
            </div>
        </div>
        <div class="col-md-4 mb-3 mb-md-0">
            <div class="d-flex flex-column justify-content-center align-items-center text-center">
                <i class="bi bi-telephone text-primary fs-1"></i>
                <h2 class="fw-bold fs-4 m-0 mb-3">Teléfono</h2>
                <p class="text-muted m-0">+1 (809)-378-2149</p>
            </div>
        </div>
        <div class="col-md-4 mb-3 mb-md-0">
            <div class="d-flex flex-column justify-content-center align-items-center text-center">
                <i class="bi bi-clock text-primary fs-1"></i>
                <h2 class="fw-bold fs-4 m-0 mb-3">Horarios</h2>
                <p class="text-muted m-0">9:00 AM a 5:00 PM (Cierre de boletería 3:30 PM)</p>
            </div>
        </div>
    </div>

    <!-- Mapa en grande -->
    <div class="row">
        <div class="col-12">
            <div class="ratio ratio-16x9" style="border-radius: 75px 0 75px 0 !important; overflow: hidden;">
                <iframe 
                    src="https://maps.google.com/maps?q=Parque%20Zoologico%20Nacional%20Arq.%20Manuel%20Valverde%20Podesta%2C%20Santo%20Domingo&t=&z=15&ie=UTF8&iwloc=&output=embed"
                    style="border: none;"
                    title="Ubicacion de ZOODOM"
                    loading="lazy">
                </iframe>
            </div>
        </div>
    </div>
</Section>

<style>
    #ubicacion {
        padding: 80px 0;
    }

    .ratio {
        border-radius: 75px 0 75px 0 !important;
    }
</style>
