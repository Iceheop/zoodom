---
import Section from "../layouts/Section.astro";
import PageIntro from "./PageIntro.astro";
import patoEntreHojasImg from "../assets/images/gallery-pato-entre-hojas.webp";
import flamencosImg from "../assets/images/gallery-flamencos.webp";
import cisneNegroImg from "../assets/images/gallery-cisne-negro.webp";
import patoLagunaAzulImg from "../assets/images/gallery-pato-laguna-azul.webp";
import hipopotamoImg from "../assets/images/gallery-hipopotamo.webp";
import tortugaAguaImg from "../assets/images/gallery-tortuga-agua.webp";
import bisontesImg from "../assets/images/gallery-bisontes.webp";
import antilopeImg from "../assets/images/gallery-antilope.webp";

const galleryImages = [
    { src: patoEntreHojasImg.src, alt: "Pato entre hojas en laguna" },
    { src: flamencosImg.src, alt: "Grupo de flamencos" },
    { src: cisneNegroImg.src, alt: "Cisne negro en agua" },
    { src: patoLagunaAzulImg.src, alt: "Pato en laguna azul" },
    { src: hipopotamoImg.src, alt: "Hipopotamo en su habitat" },
    { src: tortugaAguaImg.src, alt: "Tortuga en el agua" },
    { src: antilopeImg.src, alt: "Antilope en pradera" },
    { src: bisontesImg.src, alt: "Bisontes en campo" },
];
---

<!-- Section Gallery -->
<Section id="gallery">
    <PageIntro 
        title="Galería" 
        description="Explora nuestra colección de imágenes del zoológico."
    />
    <div class="gallery-mosaic mt-5 pt-3" role="list" aria-label="Galeria de imagenes">
        {galleryImages.map((image, index) => (
            <article class={`mosaic-item item-${index + 1}`} role="listitem">
                <button
                    type="button"
                    class="gallery-trigger"
                    data-bs-toggle="modal"
                    data-bs-target="#galleryModal"
                    data-image-src={image.src}
                    data-image-alt={image.alt}
                >
                    <img
                        src={image.src}
                        alt={image.alt}
                        class="img-fluid w-100 gallery-photo"
                        loading="lazy"
                    />
                </button>
            </article>
        ))}
    </div>
</Section>

<!-- Gallery Modal -->
<div class="modal fade" id="galleryModal" tabindex="-1" role="dialog" aria-modal="true" aria-label="Visor de imagenes de la galeria">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content bg-transparent border-0 position-relative">
            <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0" data-bs-dismiss="modal" aria-label="Cerrar visor" style="z-index: 10; background: rgba(0,0,0,0.5); padding: 8px; border-radius: 50%;"></button>
            <div class="modal-body p-0">
                <img id="galleryModalImage" src="" alt="Imagen ampliada" class="img-fluid w-100 rounded-3">
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("shown.bs.modal", function (event) {
        const target = event.target as HTMLElement | null;
        if (target?.id === "galleryModal") {
            const relatedTarget = (event as any).relatedTarget as HTMLElement | null;
            const imageSrc = relatedTarget?.dataset.imageSrc;
            const imageAlt = relatedTarget?.dataset.imageAlt;
            const img = document.getElementById("galleryModalImage") as HTMLImageElement | null;
            
            if (img && imageSrc) {
                img.src = imageSrc;
                img.alt = imageAlt || "Imagen ampliada";
            }
        }
    });
</script>

<style>
    .gallery-mosaic {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
    }

    .mosaic-item {
        overflow: hidden;
        border-radius: 50px 0px 50px 0px;
    }

    .gallery-trigger {
        width: 100%;
        height: 100%;
        padding: 0;
        border: 0;
        background: transparent;
        display: block;
        cursor: zoom-in;
        appearance: none;
    }

    .gallery-trigger:focus,
    .gallery-trigger:focus-visible {
        outline: none;
        box-shadow: none;
    }

    .gallery-photo {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    @media (min-width: 768px) {
        .gallery-mosaic {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .mosaic-item {
            min-height: 280px;
        }
    }

    @media (min-width: 992px) {
        .gallery-mosaic {
            grid-template-columns: repeat(4, minmax(0, 1fr));
            grid-template-rows: repeat(2, 280px);
        }

        .item-1 {
            grid-column: 1;
            grid-row: 1 / 3;
        }

        .item-2 {
            grid-column: 2;
            grid-row: 1;
        }

        .item-3 {
            grid-column: 3 / 5;
            grid-row: 1;
        }

        .item-4 {
            grid-column: 2;
            grid-row: 2;
        }

        .item-5 {
            grid-column: 3;
            grid-row: 2;
        }

        .item-6 {
            grid-column: 4;
            grid-row: 2;
        }

        .mosaic-item:nth-child(n + 7) {
            display: none;
        }
    }
</style>

