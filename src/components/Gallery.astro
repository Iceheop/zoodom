---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Section from "../layouts/Section.astro";
import PageIntro from "./PageIntro.astro";

interface Props {
    showAll?: boolean;
    limit?: number;
}

const { showAll = false, limit = 8 } = Astro.props as Props;

const imageModules = import.meta.glob<{ default: ImageMetadata }>("../assets/images/*.webp", {
    eager: true,
});

const allGalleryImages = Object.entries(imageModules)
    .filter(([path]) => !path.toLowerCase().endsWith("/hero.webp"))
    .sort(([a], [b]) => a.localeCompare(b, "es"))
    .map(([path, module]) => {
        const fileName = path.split("/").pop()?.replace(/\.webp$/i, "") || "imagen";
        const alt = fileName.replace(/[-_]+/g, " ").replace(/\s+/g, " ").trim();

        return {
            src: module.default,
            alt: alt.charAt(0).toUpperCase() + alt.slice(1),
        };
    });

const galleryImages = showAll ? allGalleryImages : allGalleryImages.slice(0, limit);

const getTileSizes = (index: number): string => {
    if (index === 0) return "(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw";
    if (index === 2) return "(min-width: 992px) 50vw, (min-width: 768px) 50vw, 100vw";
    return "(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw";
};
---

<!-- Section Gallery -->
<Section id="gallery">
    <PageIntro 
        title="Galería" 
        description="Explora nuestra colección de imágenes del zoológico."
    />
    <div class="gallery-mosaic mt-5 pt-3" role="list" aria-label="Galeria de imagenes">
        {galleryImages.map((image, index) => (
            <article class="mosaic-item" role="listitem">
                <button
                    type="button"
                    class="gallery-trigger"
                    data-bs-toggle="modal"
                    data-bs-target="#galleryModal"
                    data-image-src={image.src.src}
                    data-image-alt={image.alt}
                >
                    <Image
                        src={image.src}
                        alt={image.alt}
                        class="img-fluid w-100 gallery-photo"
                        loading="lazy"
                        widths={[280, 420, 514, 760, 1135]}
                        sizes={getTileSizes(index)}
                        quality={58}
                    />
                </button>
            </article>
        ))}
    </div>
</Section>

<!-- Gallery Modal -->
<div class="modal fade" id="galleryModal" tabindex="-1" role="dialog" aria-modal="true" aria-label="Visor de imagenes de la galeria">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content bg-transparent border-0 position-relative">
            <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0" data-bs-dismiss="modal" aria-label="Cerrar visor" style="z-index: 10; background: rgba(0,0,0,0.5); padding: 8px; border-radius: 50%;"></button>
            <div class="modal-body p-0">
                <img id="galleryModalImage" src="" alt="Imagen ampliada" class="img-fluid w-100 rounded-3">
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("shown.bs.modal", function (event) {
        const target = event.target as HTMLElement | null;
        if (target?.id === "galleryModal") {
            const relatedTarget = (event as any).relatedTarget as HTMLElement | null;
            const imageSrc = relatedTarget?.dataset.imageSrc;
            const imageAlt = relatedTarget?.dataset.imageAlt;
            const img = document.getElementById("galleryModalImage") as HTMLImageElement | null;
            
            if (img && imageSrc) {
                img.src = imageSrc;
                img.alt = imageAlt || "Imagen ampliada";
            }
        }
    });
</script>

<style>
    .gallery-mosaic {
        column-count: 1;
        column-gap: 1rem;
    }

    .mosaic-item {
        break-inside: avoid;
        margin-bottom: 1rem;
        border-radius: 50px 0px 50px 0px;
        overflow: hidden;
    }

    .gallery-trigger {
        width: 100%;
        height: 100%;
        padding: 0;
        border: 0;
        background: transparent;
        display: block;
        cursor: zoom-in;
        appearance: none;
    }

    .gallery-trigger:focus,
    .gallery-trigger:focus-visible {
        outline: none;
        box-shadow: none;
    }

    .gallery-photo {
        width: 100%;
        height: auto;
        display: block;
    }

    @media (min-width: 768px) {
        .gallery-mosaic {
            column-count: 2;
        }
    }

    @media (min-width: 992px) {
        .gallery-mosaic {
            column-count: 3;
        }
    }
</style>

