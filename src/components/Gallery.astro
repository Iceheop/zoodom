---
import Section from "../layouts/Section.astro";
import familiaZoodomImg from "../assets/images/gallery-familia-zoodom.webp";
import patoEntreHojasImg from "../assets/images/gallery-pato-entre-hojas.webp";
import flamencosImg from "../assets/images/gallery-flamencos.webp";
import cisneNegroImg from "../assets/images/gallery-cisne-negro.webp";
import patoLagunaAzulImg from "../assets/images/gallery-pato-laguna-azul.webp";
import hipopotamoImg from "../assets/images/gallery-hipopotamo.webp";
import tortugaAguaImg from "../assets/images/gallery-tortuga-agua.webp";
import bisontesImg from "../assets/images/gallery-bisontes.webp";
import antilopeImg from "../assets/images/gallery-antilope.webp";
import caminoSafariImg from "../assets/images/gallery-camino-safari.webp";

const galleryImages = [
    /* { src: familiaZoodomImg.src, alt: "Familia visitando el zoologico" }, */
    { src: patoEntreHojasImg.src, alt: "Pato entre hojas en laguna" },
    { src: flamencosImg.src, alt: "Grupo de flamencos" },
    { src: cisneNegroImg.src, alt: "Cisne negro en agua" },
    { src: patoLagunaAzulImg.src, alt: "Pato en laguna azul" },
    { src: hipopotamoImg.src, alt: "Hipopotamo en su habitat" },
    { src: tortugaAguaImg.src, alt: "Tortuga en el agua" },
    { src: bisontesImg.src, alt: "Bisontes en campo" },
    { src: antilopeImg.src, alt: "Antilope en pradera" },
    /* { src: caminoSafariImg.src, alt: "Camino de safari en el zoologico" } */
];
---

<!-- Section Gallery -->
<Section id="gallery">
    <header class="d-flex justify-content-between">
        <section>
            <h2 class="display-4 fw-bold text-primary m-0">Galería</h2>
            <p class="text-primary m-0">Explora nuestra colección de imágenes del zoológico.</p>
        </section>
        <section>
            <a href="#">
                <i class="text-primary bi bi-arrow-right-short display-4"></i>
            </a>
        </section>
    </header>
    <section class="gallery-mosaic mt-5 pt-3">
        {galleryImages.map((image, index) => (
            <article class={`mosaic-item item-${index + 1}`}>
                <button
                    type="button"
                    class="gallery-trigger"
                    data-bs-toggle="modal"
                    data-bs-target="#galleryModal"
                    data-image-src={image.src}
                    data-image-alt={image.alt}
                >
                    <img
                        src={image.src}
                        alt={image.alt}
                        class="img-fluid w-100 gallery-photo"
                        loading="lazy"
                    />
                </button>
            </article>
        ))}
    </section>
    <section class="modal fade" id="galleryModal" tabindex="-1" aria-hidden="true">
        <section class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <section class="modal-content bg-transparent border-0">
                <section class="modal-header border-0 pb-0">
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </section>
                <section class="modal-body pt-0">
                    <img id="galleryModalImage" src="" alt="Imagen ampliada de galeria" class="img-fluid w-100 rounded-4" />
                </section>
            </section>
        </section>
    </section>
</Section>

<script>
    const galleryModal = document.getElementById("galleryModal");
    const galleryModalImage = document.getElementById("galleryModalImage") as HTMLImageElement | null;

    galleryModal?.addEventListener("show.bs.modal", (event) => {
        const trigger = (event as any).relatedTarget as HTMLElement | null;
        if (!trigger || !galleryModalImage) return;

        const imageSrc = trigger.dataset.imageSrc || "";
        const imageAlt = trigger.dataset.imageAlt || "Imagen ampliada de galeria";

        galleryModalImage.src = imageSrc;
        galleryModalImage.alt = imageAlt;
    });
</script>

<style>
    .gallery-mosaic {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
    }

    .mosaic-item {
        overflow: hidden;
        border-radius: 50px 0px 50px 0px;
    }

    .gallery-trigger {
        width: 100%;
        height: 100%;
        padding: 0;
        border: 0;
        background: transparent;
        display: block;
        cursor: zoom-in;
        appearance: none;
    }

    .gallery-trigger:focus,
    .gallery-trigger:focus-visible {
        outline: none;
        box-shadow: none;
    }

    .gallery-photo {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    @media (min-width: 768px) {
        .gallery-mosaic {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .mosaic-item {
            min-height: 280px;
        }
    }

    @media (min-width: 992px) {
        .gallery-mosaic {
            grid-template-columns: repeat(4, minmax(0, 1fr));
            grid-template-rows: repeat(2, 280px);
        }

        .item-1 {
            grid-column: 1;
            grid-row: 1 / 3;
        }

        .item-2 {
            grid-column: 2;
            grid-row: 1;
        }

        .item-3 {
            grid-column: 3 / 5;
            grid-row: 1;
        }

        .item-4 {
            grid-column: 2;
            grid-row: 2;
        }

        .item-5 {
            grid-column: 3;
            grid-row: 2;
        }

        .item-6 {
            grid-column: 4;
            grid-row: 2;
        }

        .mosaic-item:nth-child(n + 7) {
            display: none;
        }
    }
</style>

