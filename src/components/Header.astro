---
import { Image } from "astro:assets";
import HeroImg from '../assets/images/hero.webp';
---
<!-- Header -->
<header class="position-relative py-md-5 py-lg-5 fade-in-up" id="hero">
    <div class="container px-3 px-lg-5 pb-lg-5 py-lg-3 my-5">
        <div class="row d-flex justify-content-between align-items-center position-relative h-100">
            <div class="col-lg-6 col-md-6 col-12">
                <h1 class="display-1 fw-bold lh-1">Bienvenido a nuestro zoológico</h1>
                <p>Planea una salida en familia a nuestro parque zoológico nacional para vivir una experiencia inolvidable.</p>
                <a href="#ubicacion" class="btn btn-brand px-5 py-2 rounded-pill">Planea tu visita</a>
            </div>
            <div class="col-lg-6 col-md-6 col-12 d-none d-md-block" aria-hidden="true">
                <Image
                    src={HeroImg}
                    alt="Familia visitando el zoológico"
                    class="img-fluid hero-img w-100 position-absolute bottom-0 end-0"
                    loading="eager"
                    widths={[420, 600, 866]}
                    sizes="(min-width: 992px) 50vw, (min-width: 768px) 50vw, 100vw"
                    quality={65}
                />
            </div>
        </div>
    </div>
</header>
<!-- End Header -->