---
import Section from "../layouts/Section.astro";
import CardAnimals from "./Card-Animals.astro";
import { animals } from "../data/animals";
---
<!-- Section Animals -->
<Section id="animals">
    <header class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3 mb-5">
        <section>
            <h2 class="display-4 fw-bold text-white m-0">Animales</h2>
            <p class="text-white m-0">Descubre nuestra increíble variedad de animales en su hábitat natural.</p>
        </section>
        <section>
            <a href="#">
                <i class="text-white bi bi-arrow-right-short display-4"></i>
            </a>
        </section>
    </header>
    <!-- Content -->
    <section class="animals-carousel-shell py-5 my-5 overflow-hidden">
        <section class="animals-track d-flex align-items-stretch" aria-label="Carrusel de animales">
            <section class="d-flex align-items-stretch gap-4 pe-4" aria-hidden="false">
                {animals.map((animal) => (
                    <CardAnimals
                        name={animal.name}
                        scientificName={animal.scientificName}
                        description={animal.description}
                        image={animal.image}
                        imageAlt={animal.imageAlt}
                        shapeColor={animal.shapeColor}
                        infoUrl={animal.infoUrl}
                        detailsUrl={animal.detailsUrl}
                    />
                ))}
            </section>
            <section class="d-flex align-items-stretch gap-4 pe-4" aria-hidden="true" inert>
                {animals.map((animal) => (
                    <CardAnimals
                        name={animal.name}
                        scientificName={animal.scientificName}
                        description={animal.description}
                        image={animal.image}
                        imageAlt={animal.imageAlt}
                        shapeColor={animal.shapeColor}
                        infoUrl={animal.infoUrl}
                        detailsUrl={animal.detailsUrl}
                    />
                ))}
            </section>
        </section>
    </section>
</Section>
<!-- End Section Animals -->

<style>
    .animals-track {
        width: max-content;
        animation: animals-marquee 38s linear infinite;
    }

    .animals-track:hover {
        animation-play-state: paused;
    }

    .animals-track :global(.card) {
        flex: 0 0 min(88vw, 390px);
        width: min(88vw, 390px);
    }

    @keyframes animals-marquee {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }

    @media (prefers-reduced-motion: reduce) {
        .animals-track {
            animation: none;
        }
    }

    @media (max-width: 768px) {
        .animals-track :global(.card) {
            flex-basis: 84vw;
            width: 84vw;
        }
    }
</style>